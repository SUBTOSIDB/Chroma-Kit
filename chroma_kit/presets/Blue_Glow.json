{
  "name": "Blue Glow",
  "border": "#001a33",
  "border_hover": "#66aabb",
  "bg": "#000a14",
  "bg_hover": "#001a33",
  "bg_selected": "#002a55",
  "bg_pressed": "#003a77",
  "text": "#66aabb",
  "text_disabled": "#334466",
  "accent": "#4488aa",
  "accent_bright": "#66aabb",
  "custom_qss": [
    "QMainWindow {",
    "    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,",
    "        stop:0 #003a77, stop:0.15 #002a55, stop:0.35 #001a33,",
    "        stop:0.55 #000307, stop:0.75 #003a77, stop:1 #000a14) !important;",
    "}",
    "QMenuBar {",
    "    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,",
    "        stop:0 #003a77, stop:0.3 #002a55, stop:0.7 #000307,",
    "        stop:1 #000a14) !important;",
    "    color: #ffffff;",
    "    border: 1px solid #003a77;",
    "}",
    "QToolBar {",
    "    background: #001a33 !important;",
    "    border: 1px solid #4488aa;",
    "}",
    "QStatusBar {",
    "    background: #001a33 !important;",
    "    color: #66aabb;",
    "    border: 1px solid #4488aa;",
    "}",
    "QDockWidget {",
    "    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,",
    "        stop:0 #000307, stop:0.15 #000a14, stop:0.35 #001a33,",
    "        stop:0.55 #002a55, stop:0.75 #003a77, stop:1 #002a55) !important;",
    "    border: 1px solid #4488aa;",
    "}",
    "QDockWidget::title {",
    "    background: #001a33 !important;",
    "    color: #ffffff;",
    "    border: 1px solid #4488aa;",
    "}",
    "QTabBar::tab {",
    "    background: #001a33 !important;",
    "    color: #ffffff;",
    "    border: 1px solid #4488aa;",
    "}",
    "QTabBar::tab:selected {",
    "    background: #003a77 !important;",
    "    color: #ffffff;",
    "    border: 2px solid #4488aa;",
    "}",
    "QToolButton {",
    "    background: #001a33 !important;",
    "    border: 1px solid #4488aa;",
    "    color: #ffffff;",
    "}",
    "QToolButton:hover {",
    "    background: #002a55 !important;",
    "    color: #66aabb;",
    "}",
    "QToolButton:checked, QToolButton:pressed {",
    "    background: #003a77 !important;",
    "    color: #66aabb;",
    "    border: 2px solid #66aabb;",
    "}",
    "QPushButton {",
    "    background: #001a33 !important;",
    "    border: 1px solid #4488aa;",
    "    color: #ffffff;",
    "}",
    "QPushButton:hover {",
    "    background: #002a55 !important;",
    "    color: #66aabb;",
    "}",
    "QPushButton:checked {",
    "    background: #003a77 !important;",
    "    color: #66aabb;",
    "    border: 2px solid #66aabb;",
    "}",
    "QPushButton:pressed {",
    "    background: #002a55 !important;",
    "    color: #66aabb;",
    "}",
    "QGroupBox {",
    "    background: #001a33 !important;",
    "    color: #ffffff;",
    "    border: 1px solid #4488aa;",
    "}",
    "QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {",
    "    background: #001a33 !important;",
    "    color: #ffffff;",
    "    border: 1px solid #4488aa;",
    "}",
    "QComboBox::drop-down {",
    "    background: #002a55 !important;",
    "}",
    "QCheckBox, QRadioButton {",
    "    color: #ffffff;",
    "}",
    "QCheckBox::indicator, QRadioButton::indicator {",
    "    background: #001a33 !important;",
    "    border: 1px solid #4488aa;",
    "}",
    "QAbstractItemView {",
    "    background: #001a33 !important;",
    "    color: #ffffff;",
    "    border: 1px solid #4488aa;",
    "}",
    "QAbstractItemView::item:selected, QAbstractItemView::item:selected:focus {",
    "    background: #003a77 !important;",
    "    color: #66aabb;",
    "    border: 1px solid #66aabb;",
    "}",
    "QAbstractItemView::item:hover {",
    "    background: #002a55 !important;",
    "}",
    "QTreeView, QTreeWidget, QListWidget, QListView, QTableWidget {",
    "    background: #001a33 !important;",
    "    border: 1px solid #4488aa;",
    "}",
    "QHeaderView::section {",
    "    background: #002a55 !important;",
    "    color: #66aabb;",
    "    border: 1px solid #66aabb;",
    "}",
    "QSplitter::handle {",
    "    background: #002a55 !important;",
    "}",
    "QProgressBar {",
    "    background: #002a55 !important;",
    "    border: 1px solid #4488aa;",
    "    color: #ffffff;",
    "}",
    "QProgressBar::chunk {",
    "    background: #003a77 !important;",
    "    border: 1px solid #66aabb;",
    "}",
    "QDialog {",
    "    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,",
    "        stop:0 #000307, stop:0.15 #000a14, stop:0.35 #001a33,",
    "        stop:0.55 #002a55, stop:0.75 #003a77, stop:1 #002a55) !important;",
    "}",
    "QToolTip {",
    "    background: #002a55 !important;",
    "    color: #66aabb;",
    "    border: 1px solid #4488aa;",
    "}",
    "QFrame, QStackedWidget, QScrollArea, QTabWidget, QTabWidget::pane, QSplitter, QTableCornerButton {",
    "    background: #001a33 !important;",
    "}",
    "QWidget {",
    "    background: #001a33 !important;",
    "    color: #ffffff;",
    "}",
    "QSlider::groove:vertical {",
    "    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,",
    "        stop:0 #003a77, stop:0.5 #002a55, stop:1 #001a33) !important;",
    "    border: 1px solid #4488aa;",
    "    width: 12px;",
    "}",
    "QSlider::sub-page:vertical {",
    "    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,",
    "        stop:0 #003a77, stop:1 #002a55) !important;",
    "    border: 1px solid #4488aa;",
    "}",
    "QSlider::add-line:vertical {",
    "    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,",
    "        stop:0 #003a77, stop:1 #001a33) !important;",
    "    border: 1px solid #4488aa;",
    "    height: 12px;",
    "}",
    "QSlider::sub-line:vertical {",
    "    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,",
    "        stop:0 #002a55, stop:1 #001a33) !important;",
    "    border: 1px solid #4488aa;",
    "    height: 12px;",
    "}",
    "QSlider::groove:horizontal {",
    "    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,",
    "        stop:0 #003a77, stop:0.5 #002a55, stop:1 #001a33) !important;",
    "    border: 1px solid #4488aa;",
    "    height: 12px;",
    "}",
    "QSlider::sub-page:horizontal {",
    "    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,",
    "        stop:0 #003a77, stop:1 #002a55) !important;",
    "    border: 1px solid #4488aa;",
    "}",
    "QSlider::add-line:horizontal {",
    "    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,",
    "        stop:0 #001a33, stop:1 #003a77) !important;",
    "    border: 1px solid #4488aa;",
    "    width: 12px;",
    "}",
    "QSlider::sub-line:horizontal {",
    "    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,",
    "        stop:0 #001a33, stop:1 #002a55) !important;",
    "    border: 1px solid #4488aa;",
    "    width: 12px;",
    "}",
    "QSlider::handle:horizontal {",
    "    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,",
    "        stop:0 #003a77, stop:1 #001a33) !important;",
    "    border: 1px solid #4488aa;",
    "    width: 14px;",
    "    margin: -6px 0;",
    "}",
    "QSlider::handle:vertical {",
    "    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,",
    "        stop:0 #003a77, stop:1 #001a33) !important;",
    "    border: 1px solid #4488aa;",
    "    height: 14px;",
    "    margin: 0 -6px;",
    "}"
  ]
}